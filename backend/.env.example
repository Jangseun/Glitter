# 이 파일을 복사해서 같은 폴더에 .env 파일을 만들고, 비밀번호를 바꿔서 쓰세요.
#   (PowerShell) Copy-Item .env.example .env
# .env는 .gitignore에 들어있어서 GitHub에 올라가지 않아요. 이 예시 파일만 올라가요.

# ---- docker compose가 PostgreSQL 컨테이너를 만들 때 쓰는 값 ----
POSTGRES_USER=glitter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=glitter
POSTGRES_PORT=5432

# ---- FastAPI(app/config.py)와 Alembic이 쓰는 값 ----
# 위의 사용자/비밀번호/포트/DB이름과 맞춰주세요.
# 호스트는 localhost 말고 127.0.0.1로 써주세요. Windows는 localhost를 IPv6(::1)로 먼저 시도하는데,
# DB 포트는 127.0.0.1(IPv4)에만 열어둬서 거기서 연결이 멈춰버려요.
DATABASE_URL=postgresql+psycopg://glitter:change-me@127.0.0.1:5432/glitter

# 프론트엔드(Vite 개발 서버) 주소. JSON 배열 형식
CORS_ORIGINS=["http://localhost:5173"]

# 로그인 토큰(JWT) 서명용 비밀 키. 아래 명령으로 만든 긴 무작위 문자열을 넣으세요.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
